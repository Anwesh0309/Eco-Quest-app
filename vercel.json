{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "message.html", "use": "@vercel/static" },
    { "src": "libs/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/message.html" },
    {
      "src": "/(.*)",
      "dest": "/$1",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    }
  ]
}
